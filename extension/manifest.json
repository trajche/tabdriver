{
  "manifest_version": 3,
  "name": "Tab Driver",
  "version": "0.2.0",
  "description": "Let AI agents (Claude, Codex, Cursor, ...) control tabs in your real browser session, with you watching.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "debugger",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Tab Driver",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
