{
  "manifest_version": 3,
  "name": "Tab Driver",
  "version": "0.2.0",
  "description": "Let AI agents (Claude, Codex, Cursor, ...) control tabs in your real browser session, with you watching.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Tab Driver",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabdriver@firefox",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
